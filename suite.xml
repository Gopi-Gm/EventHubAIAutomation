<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="EventHub BDD Test Suite" verbose="1">

  <!-- AI failure analysis listener — writes target/ai-analysis/ artifacts after each run -->
  <listeners>
    <listener class-name="com.api.ai.report.AiReportEnhancer"/>
  </listeners>

  <test name="EventHub Cucumber BDD Tests" thread-count="3" preserve-order="true">
    <classes>
      <class name="com.api.runners.CucumberRunner"/>
    </classes>
  </test>

</suite>
